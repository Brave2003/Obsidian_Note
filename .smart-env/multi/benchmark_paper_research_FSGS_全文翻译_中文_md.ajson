,-0.00672938,0.03239628,0.01085363,0.05672789,-0.0266966,0.00400946,0.00644014,0.21732658,-0.03352819,0.01652888,0.00816931,0.02002968,0.02379621,-0.01766861,0.00105733,0.0121376,-0.0028375,0.03153694,0.00760445,0.0030492,0.11919165,-0.01832481,0.0480781,-0.0266817,-0.01265236,-0.00360179,0.00267276,-0.01222435,0.05252464,0.09784192,-0.06728998,-0.03761525,-0.05596858,-0.02487428,-0.0205524,-0.03867289,0.05021945,0.00996187,-0.05756633,0.02025034,0.01115111,0.06051543,-0.02040628,-0.01580668,0.03305705,0.00529283,0.02295711,0.03708334,0.03655925,0.01684884],"last_embed":{"tokens":121,"hash":"a4srmn"}}},"last_read":{"hash":"a4srmn","at":1779864880127},"class_name":"SmartSource","last_import":{"mtime":1779864177930,"size":39338,"at":1779864878581,"hash":"a4srmn"},"blocks":{"#FSGS: 基于高斯泼溅的实时少样本新视角合成":[1,10],"#FSGS: 基于高斯泼溅的实时少样本新视角合成#{1}":[3,10],"#引言":[11,34],"#引言#{1}":[13,28],"#引言#{2}":[29,29],"#引言#{3}":[30,30],"#引言#{4}":[31,32],"#引言#{5}":[33,34],"#相关工作":[35,52],"#相关工作#三维重建的神经表示":[37,42],"#相关工作#三维重建的神经表示#{1}":[39,42],"#相关工作#使用稀疏视图的新视角合成":[43,52],"#相关工作#使用稀疏视图的新视角合成#{1}":[45,52],"#方法":[53,164],"#方法#{1}":[55,63],"#方法#预备知识与问题表述":[64,88],"#方法#预备知识与问题表述#{1}":[66,88],"#方法#邻近引导的高斯反池化":[89,117],"#方法#邻近引导的高斯反池化#{1}":[91,117],"#方法#高斯优化的几何引导":[118,151],"#方法#高斯优化的几何引导#{1}":[120,151],"#方法#优化":[152,164],"#方法#优化#{1}":[154,164],"#实验":[165,299],"#实验#实验设置":[167,182],"#实验#实验设置#{1}":[169,182],"#实验#与其他少样本方法的比较":[183,284],"#实验#与其他少样本方法的比较#{1}":[185,284],"#实验#消融实验":[285,299],"#实验#消融实验#{1}":[287,299],"#结论与局限性":[300,309],"#结论与局限性#{1}":[302,309],"#致谢":[310,315],"#致谢#{1}":[312,315],"#更多技术细节":[316,345],"#更多技术细节#初始化":[318,321],"#更多技术细节#初始化#{1}":[320,321],"#更多技术细节#训练":[322,345],"#更多技术细节#训练#{1}":[324,345],"#更多实验结果":[346,391],"#更多实验结果#训练视图的影响":[348,370],"#更多实验结果#训练视图的影响#{1}":[350,370],"#更多实验结果#手机数据上的FSGS":[371,380],"#更多实验结果#手机数据上的FSGS#{1}":[373,380],"#更多实验结果#渲染深度的视觉比较":[381,391],"#更多实验结果#渲染深度的视觉比较#{1}":[383,391]},"outlinks":[{"title":"FSGS管道。3D高斯从COLMAP初始化，使用少量图像（黑色相机）。对于稀疏分布的高斯，我们提出通过将现有高斯反池化为新高斯来增密新高斯，以增强场景覆盖，并适当初始化高斯属性。单目深度先验，通过采样未观测视图（红色相机）增强，引导生长的高斯优化至合理几何形状。最终损失包括光度损失项和通过深度相对对应性计算的几何正则化项。","target":"imgs/arc.png","line":60,"embedded":true},{"title":"点稀疏度与合成质量。使用3视图从COLMAP得到的SfM点（左下）明显比全视图（左上）稀疏。当训练视角数量减少时，具有稀疏SfM点的3D-GS会降低其质量。","target":"imgs/3d-gs-difficulty.png","line":85,"embedded":true},{"title":"高斯反池化示意图。我们展示了一个带有深度引导的可视化高斯反池化的二维简单案例，其中示例一维深度提供了关于高斯体相对于视角方向的相对距离的先验信息，引导高斯变形朝向更优的解。","target":"imgs/unpooling.png","line":109,"embedded":true},{"title":"在Blender数据集上的定性结果。我们的方法在物体中心数据集的视角合成任务中持续优于其他基线。","target":"imgs/main_blender.png","line":251,"embedded":true},{"title":"https://pytorch.org/hub/intelisl_midas_v2/","target":"https://pytorch.org/hub/intelisl_midas_v2/","line":328},{"title":"手机采集数据集的定性结果。我们测试了所有方法在自拍iPhone图像上的泛化能力，并使用COLMAP进行标定。尽管训练时仅采用三个视角，我们的方法仍能揭示大部分场景细节。","target":"supp_imgs/supp-ablation_self_capture.png","line":354,"embedded":true},{"title":"预测深度的视觉比较。我们可视化了所有基线方法的估计场景深度。在SparseNeRF和FreeNeRF中发现了明显的NeRF混叠伪影。3D-GS产生了过度平滑的场景几何，而我们的方法展示了视觉上令人愉悦的几何细节。","target":"supp_imgs/supp-ablation_depth.png","line":377,"embedded":true}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:benchmark/paper research/FSGS_全文翻译_中文.md#方法": {"path":null,"last_embed":{"hash":"1xem3xi","at":1779864879616},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.08428304,-0.03928911,-0.01615068,0.00324489,0.02840433,0.0473839,-0.0537539,-0.01021724,0.1053892,-0.0089669,0.00446003,-0.06635085,0.03731766,-0.00490119,0.0110957,0.00019332,0.03240092,-0.01849828,-0.01780791,-0.02456924,0.04622211,-0.06587467,-0.01232813,-0.08063439,0.02417939,0.02083124,-0.03873522,-0.06555182,-0.03410351,-0.20032156,-0.0412952,-0.04203879,-0.03185574,0.01626181,-0.02930708,-0.0256532,0.01804875,0.06362723,0.02824169,0.01994415,0.0082235,0.05265539,0.03764967,-0.00247302,0.01489867,-0.04972719,-0.021971,0.01651345,-0.02606053,-0.03403298,-0.05046123,-0.02832635,0.04697534,0.00575723,-0.00479026,0.07365759,0.0177154,0.01209918,-0.00621141,-0.01110403,0.02081393,0.04312009,-0.22067