,-0.00672938,0.03239628,0.01085363,0.05672789,-0.0266966,0.00400946,0.00644014,0.21732658,-0.03352819,0.01652888,0.00816931,0.02002968,0.02379621,-0.01766861,0.00105733,0.0121376,-0.0028375,0.03153694,0.00760445,0.0030492,0.11919165,-0.01832481,0.0480781,-0.0266817,-0.01265236,-0.00360179,0.00267276,-0.01222435,0.05252464,0.09784192,-0.06728998,-0.03761525,-0.05596858,-0.02487428,-0.0205524,-0.03867289,0.05021945,0.00996187,-0.05756633,0.02025034,0.01115111,0.06051543,-0.02040628,-0.01580668,0.03305705,0.00529283,0.02295711,0.03708334,0.03655925,0.01684884],"last_embed":{"tokens":121,"hash":"dk8p7m"}}},"last_read":{"hash":"dk8p7m","at":1779863888759},"class_name":"SmartSource","last_import":{"mtime":1779863874405,"size":39493,"at":1779863887108,"hash":"dk8p7m"},"blocks":{"#FSGS: 基于高斯泼溅的实时少样本新视角合成":[1,10],"#FSGS: 基于高斯泼溅的实时少样本新视角合成#{1}":[3,10],"#引言":[11,34],"#引言#{1}":[13,28],"#引言#{2}":[29,29],"#引言#{3}":[30,30],"#引言#{4}":[31,32],"#引言#{5}":[33,34],"#相关工作":[35,52],"#相关工作#三维重建的神经表示":[37,42],"#相关工作#三维重建的神经表示#{1}":[39,42],"#相关工作#使用稀疏视图的新视角合成":[43,52],"#相关工作#使用稀疏视图的新视角合成#{1}":[45,52],"#方法":[53,164],"#方法#{1}":[55,63],"#方法#预备知识与问题表述":[64,88],"#方法#预备知识与问题表述#{1}":[66,88],"#方法#邻近引导的高斯反池化":[89,117],"#方法#邻近引导的高斯反池化#{1}":[91,117],"#方法#高斯优化的几何引导":[118,151],"#方法#高斯优化的几何引导#{1}":[120,151],"#方法#优化":[152,164],"#方法#优化#{1}":[154,164],"#实验":[165,300],"#实验#实验设置":[167,182],"#实验#实验设置#{1}":[169,182],"#实验#与其他少样本方法的比较":[183,285],"#实验#与其他少样本方法的比较#{1}":[185,285],"#实验#消融实验":[286,300],"#实验#消融实验#{1}":[288,300],"#结论与局限性":[301,310],"#结论与局限性#{1}":[303,310],"#致谢":[311,316],"#致谢#{1}":[313,316],"#更多技术细节":[317,346],"#更多技术细节#初始化":[319,322],"#更多技术细节#初始化#{1}":[321,322],"#更多技术细节#训练":[323,346],"#更多技术细节#训练#{1}":[325,346],"#更多实验结果":[347,392],"#更多实验结果#训练视图的影响":[349,371],"#更多实验结果#训练视图的影响#{1}":[351,371],"#更多实验结果#手机数据上的FSGS":[372,381],"#更多实验结果#手机数据上的FSGS#{1}":[374,381],"#更多实验结果#渲染深度的视觉比较":[382,392],"#更多实验结果#渲染深度的视觉比较#{1}":[384,392]},"outlinks":[{"title":"FSGS管道。3D高斯从COLMAP初始化，使用少量图像（黑色相机）。对于稀疏分布的高斯，我们提出通过将现有高斯解池为新高斯来增密新高斯，以增强场景覆盖，并适当初始化高斯属性。单目深度先验，通过采样未观测视图（红色相机）增强，引导生长的高斯优化至合理几何形状。最终损失包括光度损失项和通过深度相对对应性计算的几何正则化项。","target":"imgs/arc.png","line":60,"embedded":true},{"title":"点稀疏度与合成质量。使用3视图从COLMAP得到的SfM点（左下）明显比全视图（左上）稀疏。当训练视角数量减少时，具有稀疏SfM点的3D-GS会降低其质量。","target":"imgs/3d-gs-difficulty.png","line":85,"embedded":true},{"title":"高斯反池化示意图。我们展示了一个带有深度引导的可视化高斯反池化的二维简单案例，其中示例一维深度提供了关于高斯体相对于视角方向的相对距离的先验信息，引导高斯变形朝向更优的解。","target":"imgs/unpooling.png","line":109,"embedded":true},{"title":"在Blender数据集上的定性结果。我们的方法在物体中心数据集的视角合成任务中持续优于其他基线。","target":"imgs/main_blender.png","line":251,"embedded":true},{"title":"https://pytorch.org/hub/intelisl_midas_v2/","target":"https://pytorch.org/hub/intelisl_midas_v2/","line":329},{"title":"手机采集数据集的定性结果。我们测试了所有方法在自拍iPhone图像上的泛化能力，并使用COLMAP进行标定。尽管训练时仅采用三个视角，我们的方法仍能揭示大部分场景细节。","target":"supp_imgs/supp-ablation_self_capture.png","line":355,"embedded":true},{"title":"预测深度的视觉比较。我们可视化了所有基线方法的估计场景深度。在SparseNeRF和FreeNeRF中发现了明显的NeRF混叠伪影。3D-GS产生了过度平滑的场景几何，而我们的方法展示了视觉上令人愉悦的几何细节。","target":"supp_imgs/supp-ablation_depth.png","line":378,"embedded":true}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:benchmark/paper research/FSGS_全文翻译_中文.md#FSGS: 基于高斯泼溅的实时少样本新视角合成": {"path":null,"last_embed":{"hash":null},"embeddings":{},"text":null,"length":0,"last_read":{"hash":"hxua7j","at":1779863887104},"key":"benchmark/paper research/FSGS_全文翻译_中文.md#FSGS: 基于高斯泼溅的实时少样本新视角合成","lines":[1,10],"size":186,"outlinks":[],"class_name":"SmartBlock"},
